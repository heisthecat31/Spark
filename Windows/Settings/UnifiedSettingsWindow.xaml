											  IsChecked="{Binding JoustSpeed}" />
								<TextBlock Text="{x:Static p:Resources.Speed_in_m_s_of_the_first_player_on_each_team_to_cross_the_midline_on_neutral_joust}"
								           Foreground="{DynamicResource TextFaint}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,9" />

								<CheckBox x:Name="tubeExitSpeedCheckbox" Content="{x:Static p:Resources.Tube_Exit_Speed__self_}" Style="{StaticResource ThemedCheckBox}" Margin="0,0,0,1"
