												Padding="10,6" Click="SetStorageLocation" />
									<Button x:Name="resetReplayFolder" Content="{x:Static p:Resources.Reset}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
												Padding="10,6" Click="ResetReplayFolder" />
									<Button x:Name="openReplayFolderButton" Content="{x:Static p:Resources.Open_Folder}" Style="{StaticResource SecondaryButtonStyle}"
												Padding="10,6" Click="OpenReplayFolder" />
								</StackPanel>

								<Label x:Name="splitLabel" Content="{x:Static p:Resources.Replay_File_Splitting_}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
