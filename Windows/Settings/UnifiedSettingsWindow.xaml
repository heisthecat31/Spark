										<ComboBoxItem Content="{x:Static p:Resources.Every_Match__Scoreboard_}" />
										<ComboBoxItem Content="{x:Static p:Resources.On_Server_Change}" />
										<ComboBoxItem Content="{x:Static p:Resources.Only_on_IgniteBot_Restart}" />
									</ComboBox>
									<Button x:Name="splitFileButton" Content="{x:Static p:Resources.Split_File}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
												Padding="10,6" Click="SplitFileButtonClicked" />
									<Label x:Name="currentFilenameLabel" Content="{Binding ReplayFilename, Mode=OneWay}"
									       Foreground="{DynamicResource TextFaint}" FontFamily="Consolas" FontSize="11.5"
									       VerticalAlignment="Center"
											   ScrollViewer.VerticalScrollBarVisibility="Disabled" />
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- Outside fullLoggingBox on purpose: repairing a file you already have
						     shouldn't require replay recording to be switched on. -->
						<TextBlock Text="REPAIR" Style="{StaticResource CardHeading}"/>
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock Text="Broken butter file? Convert it to echoreplay and fix it"
								           Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13"
								           TextWrapping="Wrap" Margin="0,0,0,6"/>
								<TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" FontSize="11.5" LineHeight="17" Margin="0,0,0,10">
									<Run Text="Some .butter files won't open in the replay viewer — one damaged frame is enough for it to reject the whole recording. This re-reads the file a chunk at a time, keeps everything that still decodes, and saves it alongside the original as a .echoreplay."/>
								</TextBlock>
								<StackPanel Orientation="Horizontal">
									<Button x:Name="repairButterButton" Content="Choose .butter file..."
									        Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,10,0"
									        Click="RepairButterFileClicked" />
									<Label x:Name="repairButterStatusLabel" Content=""
									       Foreground="{DynamicResource TextFaint}" FontSize="11.5"
									       VerticalAlignment="Center" />
								</StackPanel>

								<Border Height="1" Background="{DynamicResource SurfaceBorderSoft}" Margin="0,12,0,12"/>

								<TextBlock Text="Search for broken files and automatically repair them"
								           Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13"
								           TextWrapping="Wrap" Margin="0,0,0,4"/>
								<TextBlock Text="Please note this will delete the broken file too"
								           Foreground="{DynamicResource StatusWarn}" FontSize="11.5"
								           TextWrapping="Wrap" Margin="0,0,0,6"/>
								<TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" FontSize="11.5" LineHeight="17" Margin="0,0,0,10">
									<Run Text="Checks every .butter file in your save folder. A file counts as broken when the standard decoder rejects it, or when parts of it are damaged or cut short. Each one is rewritten as a .echoreplay, and the original is only deleted once the replacement has been read back and checked."/>
								</TextBlock>
								<StackPanel Orientation="Horizontal">
									<Button x:Name="scanBrokenButterButton" Content="Search and repair..."
									        Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,10,0"
									        Click="ScanBrokenButterClicked" />
									<Label x:Name="scanBrokenButterStatusLabel" Content=""
									       Foreground="{DynamicResource TextFaint}" FontSize="11.5"
									       VerticalAlignment="Center" />
								</StackPanel>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>
			</TabItem>


