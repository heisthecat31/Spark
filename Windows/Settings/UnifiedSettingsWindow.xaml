											  IsChecked="{Binding ServerLocation}" />
								<TextBlock Text="{x:Static p:Resources.Estimated_location_of_the_server_as_you_join}"
								           Foreground="{DynamicResource TextFaint}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,9" />

								<CheckBox Content="{x:Static p:Resources.Throw_Speed}" Style="{StaticResource ThemedCheckBox}" Margin="0,0,0,1"
											  IsChecked="{Binding ThrowSpeed}" />
