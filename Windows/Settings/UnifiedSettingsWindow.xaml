									<CheckBox Content="Save to .echoreplay format" Style="{StaticResource ThemedCheckBox}" Margin="0,0,20,9" IsChecked="{l:SettingBinding saveEchoreplayFiles}" />
									<CheckBox Content="Save to .butter format" Style="{StaticResource ThemedCheckBox}" Margin="0,0,20,9" IsChecked="{l:SettingBinding saveButterFiles}" />
									<CheckBox Content="Save to .tape format" Style="{StaticResource ThemedCheckBox}" Margin="0,0,0,9" IsChecked="{l:SettingBinding saveTapeFiles}" />
								</StackPanel>
								<CheckBox Content="Save player bones data" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding fetchBones}" />

								<Border Height="1" Background="{DynamicResource SurfaceBorderSoft}" Margin="0,4,0,12"/>

								<TextBlock Text="Behavior" Foreground="{DynamicResource TextFaint}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
								<CheckBox x:Name="onlyRecordPrivateMatchesCheckBox"
											  Content="{x:Static p:Resources.Only_Record_Private_Matches}" Style="{StaticResource ThemedCheckBox}"
											  IsChecked="{l:SettingBinding onlyRecordPrivateMatches}" />
								<CheckBox x:Name="batchWritesButton" Content="{x:Static p:Resources.Batch_Writes}" Style="{StaticResource ThemedCheckBox}"
											  IsChecked="{l:SettingBinding batchWrites}" />
								<CheckBox x:Name="useCompressionButton" Content="{x:Static p:Resources.Use_Compression}" Style="{StaticResource ThemedCheckBox}"
											  IsChecked="{l:SettingBinding useCompression}" />
								<Label Content="Recording rate:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
								<ComboBox x:Name="speedSelector" Style="{StaticResource ThemedComboBox}"
											  SelectedIndex="{l:SettingBinding targetDeltaTimeIndexFull}"
											  Width="211" Margin="0,0,0,12" HorizontalAlignment="Left">
									<ComboBoxItem Content="{x:Static p:Resources.Fast__60_Hz_}" />
									<ComboBoxItem Content="{x:Static p:Resources.Med__30_Hz_}" />
									<ComboBoxItem Content="{x:Static p:Resources.Slow__10_Hz_}" />
								</ComboBox>

								<Border Height="1" Background="{DynamicResource SurfaceBorderSoft}" Margin="0,0,0,12"/>

								<Label x:Name="saveLocLabel" Content="{x:Static p:Resources.Save_Folder_}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
									<TextBox x:Name="storageLocationTextBox" TextWrapping="NoWrap" Width="240"
												 Style="{StaticResource ThemedTextBox}" Margin="0,0,8,0" MaxLines="1"
												 IsReadOnly="True"
