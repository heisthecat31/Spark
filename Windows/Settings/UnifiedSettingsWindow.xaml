<Window x:Class="Spark.UnifiedSettingsWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:l="clr-namespace:Spark"
		xmlns:p="clr-namespace:Spark.Properties"
		mc:Ignorable="d"
		Title="{x:Static p:Resources.IgniteBot___Settings}"
		Height="700" Width="610"
		Top="{l:SettingBinding settingsWindowTop}"
		Left="{l:SettingBinding settingsWindowLeft}"
		Background="{DynamicResource SurfaceGround}"
		Loaded="WindowLoad"
		FontSize="14"
		Padding="10,10,10,10"
		ResizeMode="CanResize"
		SizeToContent="Manual"
		Icon="/img/ignite_logo.ico"
		WindowStartupLocation="Manual"
		DataContext="{Binding RelativeSource={RelativeSource Self}}"
		>
	<Window.Resources>
		<l:EchoVRSettingsManager x:Key="es"/>

		<!-- ══════════════ Shared settings-tab styles ══════════════ -->
		<Style x:Key="CardHeading" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
			<Setter Property="Margin" Value="2,0,0,10"/>
		</Style>

		<Style x:Key="SettingsCard" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="14"/>
			<Setter Property="Margin" Value="0,0,0,14"/>
		</Style>

		<Style x:Key="ThemedCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="Margin" Value="0,0,0,9"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<Style x:Key="ThemedComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
			<Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
			<Setter Property="Padding" Value="8,4"/>
		</Style>

		<Style x:Key="FieldLabel" TargetType="Label">
			<Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="0,4,8,4"/>
		</Style>

		<Style x:Key="ThemedTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
			<Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<Style x:Key="CardExpander" TargetType="Expander">
			<Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="0,0,0,14"/>
		</Style>

		<Style x:Key="InnerCard" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="7"/>
			<Setter Property="Padding" Value="12"/>
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>

		<Style x:Key="SliderRowLabel" TargetType="Label">
			<Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Width" Value="150"/>
			<Setter Property="Padding" Value="0,4,8,4"/>
		</Style>

		<Style x:Key="SliderValueBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
			<Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="Width" Value="44"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Margin" Value="6,0,4,0"/>
		</Style>

		<Style x:Key="UnitLabel" TargetType="Label">
			<Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="Padding" Value="0,4,0,4"/>
		</Style>

		<Style x:Key="HintText" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
		</Style>

		<Style x:Key="AccentButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource ControlAccent}"/>
			<Setter Property="Foreground" Value="{DynamicResource ControlAccentForeground}"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource ControlBrightDefaultBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SecondaryButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="12,7"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource ControlMouseOverBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="52" />
			<RowDefinition />
			<RowDefinition Height="50" />
		</Grid.RowDefinitions>
		<Label x:Name="label" Content="{x:Static p:Resources.Settings}" FontSize="20" Margin="10,10,10,0" />

		<TabControl x:Name="tabControl" SelectedIndex="0" Grid.Row="1">

			<TabItem Header="{x:Static p:Resources.General}" Padding="8,6,8,6">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="14,14,14,14">

						<StackPanel Orientation="Horizontal" Margin="0,0,0,14">
							<Button Content="{x:Static p:Resources.Show_first_time_setup_window}"
							        Style="{StaticResource SecondaryButtonStyle}"
							        Margin="0,0,10,0" HorizontalAlignment="Left" Width="207"
							        Click="ShowFirstTimeSetupWindowClicked" />
							<Button Content="{x:Static p:Resources.Open_settings_folder}"
							        Style="{StaticResource SecondaryButtonStyle}"
							        HorizontalAlignment="Left" Width="207"
							        Click="OpenSettingsFileFolder" />
						</StackPanel>

						<!-- Connection -->
						<TextBlock Text="CONNECTION" Style="{StaticResource CardHeading}"/>
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock x:Name="ThisPCLocalIP" Margin="0,0,0,10" FontSize="11.5" Foreground="{DynamicResource TextFaint}">---</TextBlock>
								<StackPanel Orientation="Horizontal">
									<Label Content="{x:Static p:Resources.EchoVR_IP__for_Quest_}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
									<Grid Width="160">
										<TextBox x:Name="EchoVRIPTextBox" Text="{l:SettingLoad echoVRIP}" TextWrapping="NoWrap" HorizontalAlignment="Stretch"
										         Style="{StaticResource ThemedTextBox}" Margin="0,0,4,0" FontFamily="Consolas" Height="32"
										         VerticalAlignment="Center" TextChanged="EchoVRIPChanged" />
										<Button x:Name="SaveQuestIPButton" Click="SaveQuestIPClicked" Style="{StaticResource SecondaryButtonStyle}"
										        Visibility="Collapsed" HorizontalAlignment="Right" Padding="8,2" Content="{x:Static p:Resources.Save}"/>
									</Grid>
									<TextBox x:Name="EchoVRPortTextBox" Text="{l:SettingLoad echoVRPort}" TextWrapping="NoWrap" Width="60"
									         Style="{StaticResource ThemedTextBox}" Margin="0,0,8,0" FontFamily="Consolas" Height="32"
									         VerticalAlignment="Center" TextChanged="EchoVRPortChanged" />
									<Button x:Name="ResetIP" Content="{x:Static p:Resources.Local_PC}" Style="{StaticResource SecondaryButtonStyle}"
									        Margin="0,0,8,0" Padding="10,6" Click="ResetIP_Click" />
									<Button x:Name="FindQuest" Content="{x:Static p:Resources.Find_Quest_IP}" Style="{StaticResource SecondaryButtonStyle}"
									        Padding="10,6" Click="FindQuestClick" />
								</StackPanel>
								<Label x:Name="FindQuestStatusLabel" Visibility="Hidden" Content="{x:Static p:Resources.Searching_for_Quest}"
								       Foreground="{DynamicResource TextFaint}" Margin="0,4,0,0" FontSize="10" FontStyle="Italic" />
								<Button Content="Simple Spectate Mode" Style="{StaticResource SecondaryButtonStyle}"
								        Margin="0,10,0,0" HorizontalAlignment="Left"
								        Click="OpenQuestSpectatorPopup"
								        ToolTip="Open Simple Spectate Mode, which follows another player with a spectator client on this PC."/>
							</StackPanel>
						</Border>

						<!-- EchoVR Executable -->
						<TextBlock Text="ECHOVR EXECUTABLE" Style="{StaticResource CardHeading}"/>
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<Label x:Name="ExeLocationLabel" Content="{x:Static p:Resources.EchoVR_Executable_Location_}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
								<TextBox Text="{l:SettingLoad echoVRPath}" TextWrapping="NoWrap"
								         Style="{StaticResource ThemedTextBox}"
								         HorizontalAlignment="Stretch"
								         Margin="0,0,0,10" TextChanged="ExecutableLocationChanged"
								         MaxLines="1" />
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
									<ProgressBar x:Name="ReshadeProgress" Visibility="Collapsed" Width="200" Margin="0,0,10,0"></ProgressBar>
									<Button Content="{x:Static p:Resources.Install_ReShade}" Style="{StaticResource SecondaryButtonStyle}" Click="InstallReshade" Margin="0,0,10,0"></Button>
									<Button Content="{x:Static p:Resources.Remove_ReShade}" Style="{StaticResource SecondaryButtonStyle}" Click="RemoveReshade"></Button>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- App Behavior -->
						<TextBlock Text="APP BEHAVIOR" Style="{StaticResource CardHeading}"/>
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
									<Label Content="{x:Static p:Resources.Language}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
									<ComboBox Style="{StaticResource ThemedComboBox}" Margin="0,0,10,0" HorizontalAlignment="Left" Width="148" SelectedIndex="{l:SettingBinding languageIndex}" >
										<ComboBoxItem>English</ComboBoxItem>
										<ComboBoxItem>æ—¥æœ¬èªž</ComboBoxItem>
									</ComboBox>
									<TextBlock Text="{x:Static p:Resources._Requires_Restart_}" Foreground="{DynamicResource TextFaint}" FontSize="11" VerticalAlignment="Center"/>
								</StackPanel>
								<!-- Redundant now that the Change Theme tab offers full colour customization.
								<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
									<Label Content="Interface Theme" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
									<ComboBox Style="{StaticResource ThemedComboBox}" SelectedIndex="{Binding SetTheme}" Width="56">
										<ComboBoxItem>
											<Rectangle Width="20" Height="20" Fill="Yellow"/>
										</ComboBoxItem>
										<ComboBoxItem>
											<Rectangle Width="20" Height="20" Fill="Orange"/>
										</ComboBoxItem>
										<ComboBoxItem>
											<Rectangle Width="20" Height="20" Fill="Red"/>
										</ComboBoxItem>
									</ComboBox>
								</StackPanel>
								-->
								<CheckBox x:Name="startWithWindowsCheckbox" Content="{x:Static p:Resources.Start_with_Windows}"
											  Style="{StaticResource ThemedCheckBox}"
											  IsChecked="{Binding StartWithWindows}" HorizontalAlignment="Left" />
								<CheckBox x:Name="startMinimizedCheckbox" Content="{x:Static p:Resources.Start_Minimized}"
											  Style="{StaticResource ThemedCheckBox}"
											  IsChecked="{l:SettingBinding startMinimized}" HorizontalAlignment="Left" />
								<CheckBox x:Name="closeButtonExitsAppCheckbox" Content="Closing Spark exits the app instead of asking to hide"
											  Style="{StaticResource ThemedCheckBox}"
											  IsChecked="{l:SettingBinding closeButtonExitsApp}" HorizontalAlignment="Left"
											  ToolTip="When enabled, clicking the close button quits Spark immediately instead of showing the 'Are you sure?' hide/exit prompt." />
								<CheckBox x:Name="enableBetasCheckbox" Content="{x:Static p:Resources.Get_Beta_Updates_to_Spark}" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding betaUpdates}" ToolTip="{x:Static p:Resources.betaUpdates_ToolTip}"/>
								<CheckBox x:Name="capturevp2Checkbox" Content="{x:Static p:Resources.Enable__capturevp2_when_launching_spectator}"
								          Style="{StaticResource ThemedCheckBox}"
								          IsChecked="{l:SettingBinding capturevp2}" HorizontalAlignment="Left" />
								<CheckBox Content="Enable -capturevp2 when launching in VR (not recommended)"
								          Style="{StaticResource ThemedCheckBox}"
								          IsChecked="{l:SettingBinding capturevp2VR}" HorizontalAlignment="Left" />
								<CheckBox x:Name="remoteLoggingCheckbox" Content="Send Logs to Ignite"
								          Style="{StaticResource ThemedCheckBox}"
								          IsChecked="{l:SettingBinding logToServer}" HorizontalAlignment="Left" Visibility="Collapsed" />
								<CheckBox x:Name="LowFrequencyModeCheckBox" Content="{x:Static p:Resources.Low_Frequency_Mode}" ToolTip="Queries the API less frequently if you are having performance problems."
								          Style="{StaticResource ThemedCheckBox}"
								          IsChecked="{l:SettingBinding lowFrequencyMode}" HorizontalAlignment="Left" />
								<CheckBox x:Name="enableAutoFocusCheckbox" Content="{x:Static p:Resources.Autofocus_EchoVR}" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding isAutofocusEnabled}" ToolTip="{x:Static p:Resources.enableAutoFocusCheckbox_ToolTip}"/>
								<CheckBox x:Name="shareGlobalPlaytimeCheckbox" Content="Contribute my playtime to the community total and leaderboard"
								          Style="{StaticResource ThemedCheckBox}" Margin="0"
								          IsChecked="{l:SettingBinding shareGlobalPlaytime}" HorizontalAlignment="Left"
								          ToolTip="Adds your hours to the 'Everyone on Spark' figure on the Session card, and puts your name on the public playtime leaderboard.&#10;Sends your Discord name — or your EchoVR name if you're not logged in to Discord — plus an anonymous per-install ID and a seconds count, once a minute. No match data.&#10;The community total still shows when this is off." />
							</StackPanel>
						</Border>

						<!-- Dashboard Tabs -->
						<TextBlock Text="DASHBOARD TABS" Style="{StaticResource CardHeading}"/>
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock Text="Which tabs are visible on the main screen" Foreground="{DynamicResource TextDim}" FontSize="11.5" Margin="0,0,0,10"/>
								<WrapPanel Orientation="Horizontal">
									<CheckBox Content="Dashboard" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showDashboardTab}" Margin="0,0,18,9" />
									<CheckBox Content="Portal" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showPortalTab}" Margin="0,0,18,9" />
									<CheckBox Content="Web Browser" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showWebBrowserTab}" Margin="0,0,18,9" />
									<CheckBox Content="Download EchoVR" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showDownloadEchoVRTab}" Margin="0,0,18,9" />
									<CheckBox Content="Atlas" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showLinksTab}" Margin="0,0,18,9" />
									<CheckBox Content="Event Log" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showEventLogTab}" Margin="0,0,18,9" />
									<CheckBox Content="Scoreboard" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showScoreboardTab}" Margin="0,0,18,9" />
									<CheckBox Content="Music" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showSpeakerSystemTab}" Margin="0,0,18,9" />
									<CheckBox Content="Server Info" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showServerInfoTab}" Margin="0,0,18,9" />
									<CheckBox Content="Camera Write" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showWriteAPITab}" Margin="0,0,18,9" />
									<CheckBox Content="Echo GP" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showEchoGPTab}" Margin="0,0,18,9" />
									<CheckBox Content="Match Rules" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showPrivateMatchRulesTab}" Margin="0,0,18,9" />
									<CheckBox Content="Choose Server" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showCreateServerTab}" Margin="0,0,18,9" />
									<CheckBox Content="PlayerCard" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showPlayerCardTab}" Margin="0,0,18,9" />
									<CheckBox Content="Friends" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showFriendsTab}" Margin="0,0,18,9" />
									<CheckBox Content="Replay Analyser" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding showReplayAnalyserTab}" Margin="0,0,18,9" />
								</WrapPanel>
							</StackPanel>
						</Border>

						<!-- Spectating -->
						<TextBlock Text="SPECTATING" Style="{StaticResource CardHeading}"/>
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock Text="Spectatorstream (spectates the highest level public match)" Foreground="{DynamicResource TextDim}" FontSize="11.5" Margin="0,0,0,8"/>
								<CheckBox Content="{x:Static p:Resources.Use_anonymous_mode_for_Spectatorstream}" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding spectatorStreamNoOVR}" ToolTip="Your username will show up as anonymous when launching the spectatorstream. This also allows you to have two instances of EchoVR open at once."/>
								<CheckBox x:Name="autorestartCheckbox" Content="{x:Static p:Resources.Autorestart_EchoVR_into_autospectator}"
											  Style="{StaticResource ThemedCheckBox}"
											  IsChecked="{l:SettingBinding autoRestart}" HorizontalAlignment="Left"
											  ToolTip="{x:Static p:Resources.Automatically_restarts_spectatorstream_when_it_crashes}" />

								<Border Height="1" Background="{DynamicResource SurfaceBorderSoft}" Margin="0,4,0,12"/>

								<TextBlock Text="{x:Static p:Resources.Spectate_Me__Opens_the_spectator_for_your_current_match_}" Foreground="{DynamicResource TextDim}" FontSize="11.5" Margin="0,0,0,8"/>
								<CheckBox Content="{x:Static p:Resources.Allow_Spectate_Me_on_local_PC}" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding allowSpectateMeOnLocalPC}" ToolTip="Enables the Spectate Me function when your IP is 127.0.0.1. This is not recommended and is still experimental."/>
								<CheckBox Content="{x:Static p:Resources.Use_anonymous_mode_in_Spectate_Me}" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding useAnonymousSpectateMe}" ToolTip="Enables the anonymous mode for the Spectate Me function. Uncheck this to use a second Oculus account for your spectator."/>
								<CheckBox Content="{x:Static p:Resources.Spectate_Me_on_by_default}" Style="{StaticResource ThemedCheckBox}" Margin="0" IsChecked="{l:SettingBinding spectateMeOnByDefault}" ToolTip="Automatically enables the Spectate Me feature when Spark starts."/>
							</StackPanel>
						</Border>

						<!-- Discord -->
						<TextBlock Text="DISCORD" Style="{StaticResource CardHeading}"/>
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<CheckBox x:Name="discordRichPresenceCheckbox" Content="{x:Static p:Resources.Discord_Rich_Presence}"
											  Style="{StaticResource ThemedCheckBox}"
											  IsChecked="{l:SettingBinding discordRichPresence}" HorizontalAlignment="Left" />
								<CheckBox x:Name="discordRichPresenceServerLocationCheckbox" Content="{x:Static p:Resources.Show_Server_Location_in_Discord_RP_status}"
											  Style="{StaticResource ThemedCheckBox}"
											  IsChecked="{l:SettingBinding discordRichPresenceServerLocation}" HorizontalAlignment="Left" />
								<CheckBox x:Name="discordRichPresenceSpectatorCheckbox" Content="{x:Static p:Resources.Discord_Rich_Presence_Spectator}"
											  Style="{StaticResource ThemedCheckBox}" Margin="0"
											  IsChecked="{l:SettingBinding discordRichPresenceSpectator}" HorizontalAlignment="Left" />
							</StackPanel>
						</Border>

						<!-- Spectator Camera Settings -->
						<TextBlock Text="SPECTATOR CAMERA" Style="{StaticResource CardHeading}"/>
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock Text="{x:Static p:Resources.CameraSettingsDescription}" Foreground="{DynamicResource TextDim}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"></TextBlock>
								<CheckBox x:Name="HideUICheckbox" Content="{x:Static p:Resources.Hide_EchoVR_UI}" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding hideEchoVRUI}" HorizontalAlignment="Left" Click="HideEchoVRUINow"/>
								<CheckBox Content="{x:Static p:Resources.Toggle_Minimap_after_Goals}" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding toggleMinimapAfterGoals}" HorizontalAlignment="Left" />
								<CheckBox x:Name="HideMinimapCheckbox" Content="{x:Static p:Resources.Don_t_Show_Minimap__M_}" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding alwaysHideMinimap}" HorizontalAlignment="Left" Click="HideMinimapNow" />
								<Label Content="Mute player comms:" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
								<ComboBox x:Name="MutePlayerCommsDropdown" Style="{StaticResource ThemedComboBox}" Margin="0,0,0,10" HorizontalAlignment="Left" Width="300" SelectionChanged="MutePlayerCommsDropdownChanged">
									<ComboBoxItem Content="{x:Static p:Resources.Don_t_Change}"/>
									<ComboBoxItem Content="{x:Static p:Resources.Mute_enemy_team}"/>
									<ComboBoxItem Content="{x:Static p:Resources.Mute_all_players}"/>
								</ComboBox>
								<CheckBox x:Name="HideNameplatesCheckbox" Content="{x:Static p:Resources.Hide_Player_Nameplates}" Style="{StaticResource ThemedCheckBox}" IsChecked="{l:SettingBinding hideNameplates}" HorizontalAlignment="Left" Click="ToggleNameplatesNow"/>
								<Label Content="{x:Static p:Resources.Camera_Mode_}" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
									<ComboBox SelectedIndex="{l:SettingBinding spectatorCamera}" Style="{StaticResource ThemedComboBox}" SelectionChanged="CameraModeDropdownChanged" Margin="0,0,10,0" HorizontalAlignment="Left" Width="300">
										<ComboBoxItem Content="{x:Static p:Resources.Auto__leave_default_}"/>
										<ComboBoxItem Content="{x:Static p:Resources.Sideline}"/>
										<ComboBoxItem Content="{x:Static p:Resources.Follow_client_player___Spectate_Me__only_}"/>
										<ComboBoxItem Content="{x:Static p:Resources.Follow_specific_player}"/>
										<ComboBoxItem Content="Follow Discholder"/>
										<ComboBoxItem Content="GoPro (Hand camera)"/>
									</ComboBox>
									<Button x:Name="findCameraNowButton" Content="{x:Static p:Resources.Find_Now}" Style="{StaticResource SecondaryButtonStyle}" Click="SpectatorCameraFindNow" Padding="12,6"/>
								</StackPanel>
								<StackPanel x:Name="followSpecificPlayerPanel" Orientation="Horizontal" Margin="0,0,0,10">
									<Label Content="{x:Static p:Resources.Follow_specific_player_name_}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
									<TextBox Text="{l:SettingBinding followPlayerName}" Style="{StaticResource ThemedTextBox}" Width="200" VerticalAlignment="Center"/>
								</StackPanel>
								<Label x:Name="followCameraModeLabel" Content="{x:Static p:Resources.Follow_client_player_camera_mode_}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
