								<TextBlock Text="{x:Static p:Resources.Maximum_speed_achieved_for_times_when_you_are_faster_than_20_m_s}"
								           Foreground="{DynamicResource TextFaint}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,9" />

