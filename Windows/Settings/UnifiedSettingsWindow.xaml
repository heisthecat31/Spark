						<WrapPanel>
							<Button x:Name="PresetBlackBtn"      Content="🐈 Black"      Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,8" Click="PresetBlack_Click"/>
							<Button x:Name="PresetBlueBtn"       Content="🌌 Blue"       Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,8" Click="PresetBlue_Click"/>
							<Button x:Name="PresetCoolPurpleBtn" Content="🔮 Cool Purple" Style="{StaticResource SecondaryButtonStyle}" Width="110" Margin="0,0,8,8" Click="PresetCoolPurple_Click"/>
							<Button x:Name="PresetDarkRedBtn"    Content="🔥 Dark Red"    Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,8" Click="PresetDarkRed_Click"/>
							<Button x:Name="PresetGreenBtn"      Content="🌳 Green"      Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,8" Click="PresetGreen_Click"/>
							<Button x:Name="PresetHotPinkBtn"    Content="💖 Hot Pink"    Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,8" Click="PresetHotPink_Click"/>
							<Button x:Name="PresetPurpleBtn"     Content="🟣 Purple"      Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,8" Click="PresetPurple_Click"/>
							<Button x:Name="PresetRedBtn"        Content="🔴 Red"         Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,8" Click="PresetRed_Click"/>
							<Button x:Name="PresetYellowBtn"     Content="🌞 Yellow"      Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,8" Click="PresetYellow_Click"/>
							<Button x:Name="PresetPinkBtn"       Content="🌸 Spark Pink"  Style="{StaticResource SecondaryButtonStyle}" Width="105" Margin="0,0,8,8" Click="PresetPink_Click"/>
							<Button x:Name="PresetPVUBtn"        Content="🔵 PVU Blue"    Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,0,8" Click="PresetPVU_Click"/>
						</WrapPanel>
					</Border>

					<!-- Apply / Reset Row -->
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
						<Button x:Name="ResetThemeBtn" Content="Reset to Default" Style="{StaticResource SecondaryButtonStyle}" Width="130" Padding="10,8" Margin="0,0,10,0"
						        Click="ResetTheme_Click"/>
						<Button x:Name="ApplyThemeBtn" Content="Apply Theme" Style="{StaticResource AccentButtonStyle}" Width="130" Padding="10,8"
						        Click="ApplyTheme_Click"/>
					</StackPanel>

				</StackPanel>
			</ScrollViewer>
			</TabItem>

		</TabControl>

<Button Content="{x:Static p:Resources.Close}" Width="100" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Right"
				Margin="10,10,10,10" Click="CloseButtonEvent" Grid.Row="2" />

		<Grid x:Name="QuestSpectatorPopup" Visibility="Collapsed" Background="#CC000000" Panel.ZIndex="1000" Grid.RowSpan="3">
			<Border Background="{DynamicResource SurfaceGround}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
					HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" CornerRadius="12" Width="450">
				<StackPanel>
					<TextBlock Text="Simple Spectate Mode" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
							   HorizontalAlignment="Center" Margin="0,0,0,6"/>
					<TextBlock Text="Spectate anyone. Follows them from match to match automatically, into private matches and lobbies too."
							   Foreground="{DynamicResource TextDim}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>

					<Label Content="Who to spectate" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
					<RadioButton x:Name="FollowFriendRadio" GroupName="QuestSpectatorTarget" Content="Anyone, by name"
								 Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Margin="0,0,0,6" IsChecked="True"
								 Checked="QuestSpectatorModeChanged"
								 ToolTip="Checks your Friends list first, then falls back to searching public matches by name."/>
					<RadioButton x:Name="FollowSelfRadio" GroupName="QuestSpectatorTarget" Content="Myself, on my other PC"
								 Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Margin="0,0,0,10"
								 Checked="QuestSpectatorModeChanged"
								 ToolTip="Log into Discord on both PCs. This client follows whatever session the playing PC reports."/>

					<StackPanel x:Name="QuestSpectatorNamePanel">
						<Label Content="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
						<TextBox x:Name="TargetNameInput" Style="{StaticResource ThemedTextBox}" Margin="0,0,0,4"/>
						<TextBlock Text="Their Echo VR or Discord name. Anyone can be followed into public matches; add them as a friend and you can follow them into private matches and lobbies as well."
								   Foreground="{DynamicResource TextFaint}" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,14"/>
					</StackPanel>

					<StackPanel x:Name="QuestSpectatorSelfPanel" Visibility="Collapsed">
						<TextBlock Text="Log into Discord in Spark on both PCs. The playing PC publishes the session it is in and this one follows it, private matches and lobbies included."
								   Foreground="{DynamicResource TextFaint}" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,14"/>
					</StackPanel>

					<CheckBox x:Name="AnonymousModeCheckbox" Content="Use anonymous mode" Style="{StaticResource ThemedCheckBox}"
							  IsChecked="True"
							  ToolTip="Launches EchoVR with -noovr so this spectator client uses an anonymous account instead of your real one."/>

					<CheckBox x:Name="AutoJoinCheckbox" Content="Keep following them between sessions" Style="{StaticResource ThemedCheckBox}" Margin="0,0,0,4"
							  IsChecked="True"
							  ToolTip="If checked, Spark keeps watching where they are and moves this spectator client whenever they change session."/>

					<TextBlock x:Name="QuestSpectatorStatusText" Text="" Foreground="{DynamicResource TextDim}" FontSize="11"
							   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
						<Button x:Name="StopQuestSpectatorButton" Content="Stop Following" Style="{StaticResource SecondaryButtonStyle}"
								Click="StopQuestSpectator" Margin="0,0,10,0" Padding="16,7" Visibility="Collapsed"/>
						<Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Click="CloseSpectatorPopup" Margin="0,0,10,0" Padding="16,7"/>
						<Button x:Name="LaunchQuestSpectatorButton" Content="Launch Spectator" Style="{StaticResource AccentButtonStyle}" Click="LaunchQuestSpectator" Padding="16,7"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</Window>
